[Unit]
Description=LocalRetail kiosk first-boot setup
After=network-online.target
Wants=network-online.target
# Do not hard-fail if network-online is slow/skipped
ConditionPathExists=!/var/lib/localretail/kiosk-setup.done

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/localretail-kiosk-setup.sh
RemainAfterExit=yes
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
