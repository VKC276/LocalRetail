#cloud-config
# Ubuntu 24.04 Server autoinstall — LocalRetail kiosk (lightweight Openbox, not GNOME).
# Seed: /ventoy/cidata/ + optional cidata.img (Ventoy persistence). GRUB via conf_replace.

autoinstall:
  version: 1
  interactive-sections: []
  locale: sv_SE.UTF-8
  keyboard:
    layout: se
    variant: ""
    toggle: null
  timezone: Europe/Stockholm
  source:
    id: ubuntu-server-minimal
    search_drivers: true

  identity:
    hostname: kiosk-01
    username: kiosk
    password: "REPLACE_WITH_PASSWORD_HASH"

  network:
    version: 2
    ethernets:
      all-en:
        match:
          name: "en*"
        dhcp4: true
        optional: true
      all-eth:
        match:
          name: "eth*"
        dhcp4: true
        optional: true

  ssh:
    install-server: true
    allow-pw: true

  storage:
    layout:
      name: direct
      match:
        size: largest

  # Lightweight desktop: Openbox + LightDM (no GNOME — fewer crashes on thin clients)
  packages:
    - openssh-server
    - xorg
    - xinit
    - openbox
    - lightdm
    - lightdm-gtk-greeter
    - unattended-upgrades
    - curl
    - ca-certificates
    - x11-xserver-utils
    - unclutter
    - console-setup
    - keyboard-configuration
    - chromium-browser
    - fonts-dejavu-core

  user-data:
    keyboard:
      layout: se
    runcmd:
      - [ /usr/local/sbin/localretail-kiosk-setup.sh ]

  late-commands:
    - curtin in-target --target=/target -- mkdir -p /usr/local/sbin /opt/localretail/bin /etc/systemd/system /etc/lightdm
    # Seed scripts: Ventoy folder and/or cidata volume
    - |
      set -e
      SRC=""
      for p in /ventoy/cidata /cdrom/cidata /media/*/cidata /mnt/*; do
        if [ -f "$p/localretail-kiosk-setup.sh" ]; then SRC="$p"; break; fi
      done
      if [ -z "$SRC" ]; then
        SRC=$(find /ventoy /cdrom /media /mnt -name localretail-kiosk-setup.sh 2>/dev/null | head -1 | xargs dirname 2>/dev/null || true)
      fi
      test -n "$SRC"
      cp "$SRC/localretail-kiosk-setup.sh" /target/usr/local/sbin/
      cp "$SRC/open-kiosk.sh" /target/opt/localretail/bin/
      cp "$SRC/localretail-kiosk-setup.service" /target/etc/systemd/system/
    - curtin in-target --target=/target -- chmod 755 /usr/local/sbin/localretail-kiosk-setup.sh /opt/localretail/bin/open-kiosk.sh
    - curtin in-target --target=/target -- systemctl enable localretail-kiosk-setup.service
    - curtin in-target --target=/target -- systemctl enable ssh.service || curtin in-target --target=/target -- systemctl enable sshd.service || true
    - curtin in-target --target=/target -- systemctl enable lightdm.service || true
    - curtin in-target --target=/target -- systemctl set-default graphical.target || true
    # LightDM autologin (X11)
    - printf '%s\n' '[Seat:*]' 'autologin-user=kiosk' 'autologin-user-timeout=0' 'user-session=openbox' 'greeter-session=lightdm-gtk-greeter' > /target/etc/lightdm/lightdm.conf
    # Swedish keyboard
    - printf '%s\n' 'XKBMODEL="pc105"' 'XKBLAYOUT="se"' 'XKBVARIANT=""' 'XKBOPTIONS=""' 'BACKSPACE="guess"' > /target/etc/default/keyboard
    - curtin in-target --target=/target -- setupcon --force || true
    - curtin in-target --target=/target -- localectl set-x11-keymap se pc105 || true
    - curtin in-target --target=/target -- localectl set-keymap se || true
    # Thin-client graphics
    - curtin in-target --target=/target -- sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="nomodeset quiet splash"/' /etc/default/grub
    - curtin in-target --target=/target -- update-grub || true
    - curtin in-target --target=/target -- apt-get update || true
    - curtin in-target --target=/target -- apt-get install -y openssh-server console-setup keyboard-configuration chromium-browser || curtin in-target --target=/target -- apt-get install -y chromium || true
    - mkdir -p /target/etc/systemd/system/systemd-networkd-wait-online.service.d
    - printf '%s\n' '[Service]' 'ExecStart=' 'ExecStart=/lib/systemd/systemd-networkd-wait-online --any --timeout=20' 'TimeoutStartSec=25' > /target/etc/systemd/system/systemd-networkd-wait-online.service.d/override.conf
    - mkdir -p /target/etc/systemd/system/NetworkManager-wait-online.service.d
    - printf '%s\n' '[Service]' 'TimeoutStartSec=20' > /target/etc/systemd/system/NetworkManager-wait-online.service.d/override.conf
