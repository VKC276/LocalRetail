#cloud-config
# Ubuntu 24.04 LTS autoinstall for LocalRetail kiosk.
# Boot the Ubuntu Server 24.04 ISO with this seed attached (see README.md).
#
# Password hash is filled by ensure-password.sh / create-usb.sh (REPLACE_WITH_PASSWORD_HASH).
# Seed path on Ventoy USB: /ventoy/cidata/ (see create-usb.sh + conf_replace GRUB).

autoinstall:
  version: 1
  # Empty = fully noninteractive (no language/keyboard/disk dialogs).
  interactive-sections: []
  locale: sv_SE.UTF-8
  keyboard:
    layout: se
    variant: ""
    toggle: null
  timezone: Europe/Stockholm
  source:
    id: ubuntu-server-minimal
    search_drivers: true

  identity:
    hostname: kiosk-01
    username: kiosk
    # openssl passwd -6 'DittLösen'
    password: "REPLACE_WITH_PASSWORD_HASH"

  network:
    version: 2
    ethernets:
      all-en:
        match:
          name: "en*"
        dhcp4: true
      all-eth:
        match:
          name: "eth*"
        dhcp4: true

  ssh:
    install-server: true
    allow-pw: true
    # authorized-keys:
    #   - "ssh-ed25519 AAAA... admin@vkc"

  storage:
    layout:
      name: direct
      match:
        size: largest

  packages:
    - openssh-server
    - ubuntu-desktop-minimal
    - gdm3
    - unattended-upgrades
    - curl
    - ca-certificates
    - x11-xserver-utils
    - unclutter
    - console-setup
    - keyboard-configuration

  user-data:
    keyboard:
      layout: se
    runcmd:
      - [ /usr/local/sbin/localretail-kiosk-setup.sh ]

  # Scripts live on the Ventoy partition at /ventoy/cidata/ (not inside the Ubuntu ISO).
  late-commands:
    - curtin in-target --target=/target -- mkdir -p /usr/local/sbin /opt/localretail/bin /etc/systemd/system /etc/gdm3
    - cp /ventoy/cidata/localretail-kiosk-setup.sh /target/usr/local/sbin/localretail-kiosk-setup.sh
    - cp /ventoy/cidata/open-kiosk.sh /target/opt/localretail/bin/open-kiosk.sh
    - cp /ventoy/cidata/localretail-kiosk-setup.service /target/etc/systemd/system/localretail-kiosk-setup.service
    - curtin in-target --target=/target -- chmod 755 /usr/local/sbin/localretail-kiosk-setup.sh /opt/localretail/bin/open-kiosk.sh
    - curtin in-target --target=/target -- systemctl enable localretail-kiosk-setup.service
    - curtin in-target --target=/target -- systemctl enable ssh.service || curtin in-target --target=/target -- systemctl enable sshd.service || true
    # Xorg + autologin before first graphical login (avoids Wayland crash loops)
    - printf '%s\n' '[daemon]' 'AutomaticLoginEnable=true' 'AutomaticLogin=kiosk' 'WaylandEnable=false' > /target/etc/gdm3/custom.conf
    # Swedish keyboard for console (TTY) and X11
    - printf '%s\n' 'XKBMODEL="pc105"' 'XKBLAYOUT="se"' 'XKBVARIANT=""' 'XKBOPTIONS=""' 'BACKSPACE="guess"' > /target/etc/default/keyboard
    - curtin in-target --target=/target -- setupcon --force || true
    - curtin in-target --target=/target -- localectl set-x11-keymap se pc105 || true
    - curtin in-target --target=/target -- localectl set-keymap se || true    # Safer graphics on thin clients / Oracle Workstation
    - curtin in-target --target=/target -- sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="nomodeset quiet splash"/' /etc/default/grub
    - curtin in-target --target=/target -- update-grub || true
    - curtin in-target --target=/target -- apt-get update
    - curtin in-target --target=/target -- apt-get install -y openssh-server console-setup keyboard-configuration || true
